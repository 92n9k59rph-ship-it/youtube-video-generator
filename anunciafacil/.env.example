# Copia este archivo como .env.local (en tu ordenador) o pon estas variables en Vercel.
# NUNCA subas los valores reales a GitHub.

# Dirección pública de la aplicación (sin barra al final)
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo de Claude. Opus 5.5 da la mejor calidad; claude-sonnet-5-5 o claude-haiku-5-5 cuestan menos.
CLAUDE_MODEL=claude-opus-5-5

# Stripe → Developers → API keys / Products / Webhooks
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Límites de uso
# Generaciones de prueba gratis antes de pagar. 0 = sin prueba gratis.
FREE_GENERATIONS=3
MONTHLY_GENERATIONS=100
