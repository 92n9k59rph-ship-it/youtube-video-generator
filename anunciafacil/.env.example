# Copia este archivo como .env.local (en tu ordenador) o pon estas variables en Vercel.
# NUNCA subas los valores reales a GitHub.

# Dirección pública de la aplicación (sin barra al final)
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo de Claude. Opus 5.5 da la mejor calidad; claude-sonnet-5-5 o claude-haiku-5-5 cuestan menos.
CLAUDE_MODEL=claude-opus-5-5

# Stripe → Developers → API keys / Products / Webhooks
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# CAPTCHA (opcional, recomendado): Cloudflare Turnstile → Site Key. La Secret Key va en Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Correos que pueden ver el panel de administración (/admin), separados por comas.
ADMIN_EMAILS=anunciafacil.contacto@gmail.com

# Límites de uso
# Lanzamiento gratis: true = nadie paga (hasta LAUNCH_MONTHLY_GENERATIONS al mes por cliente).
# Mientras esté en true no hace falta configurar Stripe. Para empezar a cobrar, pon false.
FREE_LAUNCH=true
LAUNCH_MONTHLY_GENERATIONS=20
# Número de negocios registrados al que se avisa de que pasa a ser de pago (se muestra en la web).
LAUNCH_GOAL=250

# Generaciones de prueba gratis antes de pagar (solo cuando FREE_LAUNCH=false). 0 = sin prueba gratis.
FREE_GENERATIONS=3
MONTHLY_GENERATIONS=100
